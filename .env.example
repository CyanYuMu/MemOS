# 控制台后端 origin。
#   留空 = 同源，走 /api。开发态由 vite.config.ts 把 /api 代理到 mock 后端（pnpm mock）。
#   接真后端时改这里指向对方，前端代码一行不用动。
VITE_API_BASE=

# 记忆服务地址，用于文档/快速开始里展示的接入信息。
# 默认 http://localhost:8002；生产 MCP 独立域名时用 https://example.invalid
# 可选：仅本地Vite/独立静态部署使用；Go部署从 /runtime-config.js 读取运行时地址。
VITE_SERVICE_BASE=

# mock 后端（pnpm mock）
MOCK_PORT=5280
MOCK_DB=.data/mock-db.json

# 前端 /api 的代理目标，默认 http://localhost:5280（pnpm mock）。
# 指向已部署的后端就能直接看线上真实数据，不用再起 mock：
#   MOCK_ORIGIN=http://<后端地址>
# 后端用登录页鉴权时，/__login、/__logout 也会一起代理，浏览器需先访问 /__login。
MOCK_ORIGIN=
