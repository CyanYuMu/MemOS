{
  "name": "memos-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite --port 5274 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5275 --strictPort",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && node tools/icon-audit.mjs && pnpm diff:selftest && pnpm prompts:logic && pnpm datetime:selftest && pnpm prompts:contract && pnpm prompts:selftest && pnpm build",
    "mock": "node --watch server/mock/server.ts",
    "dev:all": "concurrently -n mock,web -c cyan,green \"pnpm mock\" \"pnpm dev\"",
    "test": "vitest run",
    "diff:selftest": "node src/lib/diff.selftest.ts",
    "prompts:logic": "node src/lib/prompts.selftest.ts",
    "prompts:contract": "node src/lib/prompts.contract.selftest.ts",
    "prompts:selftest": "node server/mock/prompts.selftest.ts",
    "datetime:selftest": "node src/lib/datetime.selftest.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "driver.js": "1.10.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lowlight": "3.3.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
